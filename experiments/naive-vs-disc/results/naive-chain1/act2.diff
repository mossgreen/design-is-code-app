+	/**
+	 * Calculates the fee for cancelling an appointment. When the clinic initiates the
+	 * cancellation the owner is never charged. Owner-initiated cancellations follow the
+	 * late-fee rules: a visit cancelled at least {@link #LATE_CANCELLATION_WINDOW} before
+	 * its appointment is free; cancelling later incurs the
+	 * {@link #LATE_CANCELLATION_FEE}.
+	 * @param appointment the moment the visit is scheduled for
+	 * @param cancellationTime the moment the cancellation is requested
+	 * @param initiator who requested the cancellation
+	 * @return the fee charged for the cancellation
+	 * @throws IllegalStateException if the appointment is not in the future relative to
+	 * the cancellation time (a visit that has already happened cannot be cancelled)
+	 */
+	public static BigDecimal cancellationFee(LocalDateTime appointment, LocalDateTime cancellationTime,
+			CancellationInitiator initiator) {
 		if (!appointment.isAfter(cancellationTime)) {
 			throw new IllegalStateException("A visit that has already happened cannot be cancelled");
 		}
+		if (initiator == CancellationInitiator.CLINIC) {
+			return NO_CANCELLATION_FEE;
+		}
 		Duration leadTime = Duration.between(cancellationTime, appointment);
 		return leadTime.compareTo(LATE_CANCELLATION_WINDOW) >= 0 ? NO_CANCELLATION_FEE : LATE_CANCELLATION_FEE;
 	}
