+package org.springframework.samples.petclinic.owner;
+
+import java.time.LocalDateTime;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalStateException;
+
+/**
+ * Tests for cancelling a {@link Visit}, covering the late-cancellation fee rules and the
+ * removal of a cancelled visit from an owner's pet.
+ */
+class VisitCancellationTests {
+
+	private static final LocalDateTime NOW = LocalDateTime.of(2025, 1, 1, 12, 0);
+
+	@Test
+	void cancelling120HoursAheadChargesNoFee() {
+		assertThat(Visit.cancellationFee(NOW.plusHours(120), NOW)).isEqualByComparingTo("0.00");
+	}
+
+	@Test
+	void cancellingExactly48HoursAheadChargesNoFee() {
+		assertThat(Visit.cancellationFee(NOW.plusHours(48), NOW)).isEqualByComparingTo("0.00");
+	}
+
+	@Test
+	void cancelling47HoursAheadChargesLateFee() {
+		assertThat(Visit.cancellationFee(NOW.plusHours(47), NOW)).isEqualByComparingTo("20.00");
+	}
+
+	@Test
+	void cancelling2HoursAheadChargesLateFee() {
+		assertThat(Visit.cancellationFee(NOW.plusHours(2), NOW)).isEqualByComparingTo("20.00");
+	}
+
+	@Test
+	void cancellingAPastVisitIsRejected() {
+		assertThatIllegalStateException().isThrownBy(() -> Visit.cancellationFee(NOW.minusHours(1), NOW));
+	}
+
+	@Test
+	void cancelledVisitIsRemovedFromOwnersPet() {
+		Owner owner = new Owner();
+		Pet pet = new Pet();
+		owner.addPet(pet);
+		pet.setId(1);
+		Visit visit = new Visit();
+		pet.addVisit(visit);
+
+		pet.removeVisit(visit);
+
+		assertThat(owner.getPet(1).getVisits()).doesNotContain(visit);
+	}
+
+}
