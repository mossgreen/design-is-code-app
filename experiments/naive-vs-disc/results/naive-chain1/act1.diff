 package org.springframework.samples.petclinic.owner;
 
+import java.math.BigDecimal;
+import java.time.Duration;
 import java.time.LocalDate;
+import java.time.LocalDateTime;
 
 import org.springframework.format.annotation.DateTimeFormat;
 import org.springframework.samples.petclinic.model.BaseEntity;
@@ -35,6 +38,13 @@ import jakarta.validation.constraints.NotBlank;
 @Table(name = "visits")
 public class Visit extends BaseEntity {
 
+	/** Cancelling within this window of the appointment incurs a late fee. */
+	public static final Duration LATE_CANCELLATION_WINDOW = Duration.ofHours(48);
+
+	public static final BigDecimal NO_CANCELLATION_FEE = new BigDecimal("0.00");
+
+	public static final BigDecimal LATE_CANCELLATION_FEE = new BigDecimal("20.00");
+
 	@Column(name = "visit_date")
 	@DateTimeFormat(pattern = "yyyy-MM-dd")
 	private LocalDate date;
@@ -65,4 +75,22 @@ public class Visit extends BaseEntity {
 		this.description = description;
 	}
 
+	/**
+	 * Calculates the fee for cancelling an appointment. A visit cancelled at least
+	 * {@link #LATE_CANCELLATION_WINDOW} before its appointment is free; cancelling later
+	 * incurs the {@link #LATE_CANCELLATION_FEE}.
+	 * @param appointment the moment the visit is scheduled for
+	 * @param cancellationTime the moment the cancellation is requested
+	 * @return the fee charged for the cancellation
+	 * @throws IllegalStateException if the appointment is not in the future relative to
+	 * the cancellation time (a visit that has already happened cannot be cancelled)
+	 */
+	public static BigDecimal cancellationFee(LocalDateTime appointment, LocalDateTime cancellationTime) {
+		if (!appointment.isAfter(cancellationTime)) {
+			throw new IllegalStateException("A visit that has already happened cannot be cancelled");
+		}
+		Duration leadTime = Duration.between(cancellationTime, appointment);
+		return leadTime.compareTo(LATE_CANCELLATION_WINDOW) >= 0 ? NO_CANCELLATION_FEE : LATE_CANCELLATION_FEE;
+	}
+
 }
